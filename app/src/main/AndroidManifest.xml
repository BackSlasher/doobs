<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Normal permission; lets us hand alarms/timers to the clock app without
         bouncing the user through its UI (EXTRA_SKIP_UI). -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- Only for "I parked here", and only asked for when first used.
         Coarse alone would put the car on the wrong side of the car park. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />

    <!-- Needed to see (and hand work to) the clock app on API 30+. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_TIMER" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- Launched by package name, which Android 11+ hides unless asked for:
             without this, getLaunchIntentForPackage returns null and Translate
             looks uninstalled even when it is right there. -->
        <package android:name="com.google.android.apps.translate" />
        <!-- A browser, for the web fallbacks. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <!-- Google Tasks, via Calendar's task composer. -->
        <intent>
            <action android:name="android.intent.action.CREATE_REMINDER" />
        </intent>
        <!-- Maps, for walking back to the car. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="google.navigation" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Doobs">

        <!-- The one and only UI. Reached from the launcher, from the assist
             gesture directly (ACTION_ASSIST), and from our own session. -->
        <activity
            android:name=".AssistActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Doobs.Assist">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Lets doobs be picked as Settings -> Default apps -> Digital assistant app. -->
        <service
            android:name=".voice.DoobsVoiceInteractionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/interaction_service" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>

        <service
            android:name=".voice.DoobsVoiceInteractionSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />

        <!-- The platform requires the assistant to name a RecognitionService in its
             own package. Ours is a thin pass-through to the system recognizer. -->
        <!-- Exported and unguarded because that is what RecognitionService is: a
             service other apps bind to. Ours refuses every request, so there is
             nothing behind the door. -->
        <service
            android:name=".voice.DoobsRecognitionService"
            android:exported="true"
            android:label="@string/app_name"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/recognition_service" />
        </service>
    </application>
</manifest>
