<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="28dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/prompt_tap_to_speak"
        android:textColor="@color/on_sheet"
        android:textSize="20sp" />

    <!-- Shown only while something is actually in flight, so its presence
         means "still going" rather than being permanent furniture. -->
    <ProgressBar
        android:id="@+id/working"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="14dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/accent"
        android:visibility="gone" />

    <!-- What you said. Stays put; the grammar below it is a separate view so
         the two never overwrite each other. -->
    <TextView
        android:id="@+id/transcript"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:minLines="1"
        android:textColor="@color/on_sheet_dim"
        android:textSize="15sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="@color/divider" />

    <TextView
        android:id="@+id/grammar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="monospace"
        android:gravity="start"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/on_sheet_dim"
        android:textSize="12sp" />

    <ImageButton
        android:id="@+id/mic"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_mic"
        android:contentDescription="@string/mic_content_description"
        android:scaleType="center"
        android:src="@drawable/ic_mic"
        android:tint="@color/sheet" />
</LinearLayout>
